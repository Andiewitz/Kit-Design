{
  "name": "kit-design",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client/app",
    "client/web",
    "services"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "npm run dev:app",
    "dev:app": "npm run dev --workspace @kit/app",
    "dev:web": "npm run dev --workspace @kit/web",
    "dev:services": "npm run dev --workspace @kit/services",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  }
}

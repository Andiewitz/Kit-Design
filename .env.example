APP_ENV=development
PORT=3001
DATABASE_URL=postgres://kit:kit_dev_password@localhost:5432/kit?sslmode=disable
APP_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Generate with: go run ./services/user/cmd/keygen
# Leave empty in development to use an ephemeral signing key.
JWT_PRIVATE_KEY=
JWT_KEY_ID=dev-1
JWT_ISSUER=kit-user
JWT_AUDIENCE=kit-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

COOKIE_SECURE=false
COOKIE_DOMAIN=

MAILER=smtp
SMTP_ADDR=localhost:1025
MAIL_FROM=no-reply@kit.local

# Shared with trusted callers of POST /internal/v1/authz/check.
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me

RATE_LIMIT_ENABLED=true
LOG_LEVEL=info
AUTO_MIGRATE=false
